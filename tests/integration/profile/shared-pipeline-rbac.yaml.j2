# Since KFP 2.16.1, create/update/delete on shared pipelines (pipelines with no namespace)
# are authorized against the KFP system namespace (the kfp-api model namespace).
# Grant the test user edit permissions on pipelines there, mirroring upstream's
# test_data/kubernetes/seaweedfs/shared-pipeline-rbac.yaml.
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: shared-pipeline-edit
  namespace: {{ namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: kubeflow-pipelines-edit
subjects:
- apiGroup: rbac.authorization.k8s.io
  kind: User
  name: {{ user }}
